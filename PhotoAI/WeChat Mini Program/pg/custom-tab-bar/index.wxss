/* 固定导航的内容区为 108rpx，底部安全区另加，避免全面屏遮挡。 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: var(--card, #FFFFFF);
  border-top: 1rpx solid var(--line, #EDE8E5);
  color: var(--ink-3, #9A8F88);
  z-index: 999;
}

.tab-item {
  width: 112rpx;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon-wrap,
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.tab-icon {
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

.tab-text {
  font-size: 20rpx;
  line-height: 20rpx;
  white-space: nowrap;
}

.tab-item-active {
  color: var(--pink, #FF6B35);
  font-weight: 700;
}

.tab-publish {
  width: 80rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--pink, #FF6B35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item-active .tab-publish {
  background: var(--pink, #FF6B35);
}

