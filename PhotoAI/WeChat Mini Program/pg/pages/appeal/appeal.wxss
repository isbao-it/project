/* 账号申诉页：单卡片表单，与小程序其它页保持同一背景与圆角语言 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
  background: #F6F7F8;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2328;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
  margin-bottom: 28rpx;
}

.input {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1F2328;
  background: #F9FAFB;
  border: 2rpx solid #EEF0F3;
  border-radius: 14rpx;
}

.counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #9CA3AF;
}

.submit {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  background: #FF6B35;
  border-radius: 44rpx;
}

.submit[disabled] {
  opacity: 0.6;
}

.done {
  padding: 32rpx 0 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #16A34A;
}

.tip {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9CA3AF;
}
