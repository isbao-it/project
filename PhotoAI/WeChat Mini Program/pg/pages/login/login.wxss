.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.login-card {
  width: 100%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.login-header { text-align: center; margin-bottom: 48rpx; }
.login-title { display: block; font-size: 40rpx; font-weight: 700; color: #1f2937; margin-bottom: 16rpx; }
.login-subtitle { display: block; font-size: 26rpx; color: #6b7280; }
.login-btn, .guest-btn {
  width: 100%;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
}
.login-btn { background-color: #3b82f6; color: #fff; }
.guest-btn { margin-top: 24rpx; background-color: #f3f4f6; color: #374151; }
.login-btn::after, .guest-btn::after { border: none; }
.login-btn[disabled] { background-color: #93c5fd; color: #fff; }
.login-footer { text-align: center; margin-top: 40rpx; }
.footer-text { font-size: 24rpx; line-height: 1.7; color: #6b7280; }
