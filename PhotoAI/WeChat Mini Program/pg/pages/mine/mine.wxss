/* 页面只让下方内容区滚动，头部参与 flex 布局，避免遮挡列表。 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.header-area { flex: none; }
.me-hero {
  height: 240rpx;
  background: linear-gradient(135deg, #FB7299, #FF9EB5 60%, #FFD1DC);
}
.me-card {
  position: relative;
  margin: -60rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--card);
}
.me-top { display: flex; align-items: center; gap: 20rpx; }
.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border: 6rpx solid #FFFFFF;
  margin-top: -60rpx;
  border-radius: 50%;
  flex: none;
}
.profile-text { flex: 1; min-width: 0; }
.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  overflow-wrap: break-word;
}
.profile-bio {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.stats { display: flex; margin-top: 24rpx; }
.stat { flex: 1; text-align: center; border-left: 1rpx solid var(--line); }
.stat:first-child { border-left: 0; }
.stat-hover { opacity: .6; }
.stat-number { display: block; font-size: 32rpx; font-weight: 700; color: var(--ink); }
.stat-label { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--ink-3); }
.me-tabs {
  display: flex;
  width: 100%;
  margin-top: 20rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}
.me-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink-2);
}
.me-tab.on { position: relative; color: var(--pink); font-weight: 700; }
.me-tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -4rpx;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  border-radius: 4rpx;
  top: auto;
  right: auto;
  background: var(--pink);
}
.content { flex: 1; min-height: 0; }
/* 底部导航高 108rpx；额外留白及安全区让末项和重试按钮可见。 */
.content-inner { padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); }
.works-header { font-size: 32rpx; font-weight: 600; color: var(--ink); margin-bottom: 20rpx; }
.works-total { font-size: 24rpx; font-weight: 400; color: var(--ink-3); margin-left: 16rpx; }
.work-card { position: relative; display: flex; align-items: flex-start; padding: 24rpx; margin-bottom: 20rpx; }
.work-image { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--bg); flex-shrink: 0; }
.work-info { flex: 1; min-width: 0; margin-left: 24rpx; padding-right: 140rpx; }
.fav-remove {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 8rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card, #FFFFFF);
}
.work-title { display: block; margin-bottom: 16rpx; font-size: 30rpx; color: var(--ink); overflow-wrap: break-word; }
.work-reason { display: block; margin-top: 16rpx; font-size: 24rpx; color: var(--ink-3); white-space: pre-wrap; overflow-wrap: break-word; }
.empty-tip, .loading-tip { text-align: center; padding: 40rpx 16rpx; color: var(--ink-3); font-size: 28rpx; }
.retry-btn { margin-top: 20rpx; border-radius: 44rpx; font-size: 28rpx; }
.retry-btn::after { border: 0; }
.me-list { overflow: hidden; border-radius: 24rpx; }
/* 开关组与底部操作组之间的视觉分隔，避免误触退出登录 */
.me-divider {
  height: 1rpx;
  margin: 16rpx 24rpx;
  background: var(--line);
}
.me-item {
  display: block;
  width: 100%;
  margin: 0;
  padding: 28rpx;
  border: 0;
  border-bottom: 1rpx solid var(--line);
  border-radius: 0;
  text-align: left;
  font-size: 28rpx;
  line-height: 1.5;
  background: var(--card);
  color: var(--ink);
}
.me-item:last-child { border-bottom: 0; }
.me-item::after { border: 0; }
.logout-btn { color: var(--pink); }
.privacy-row { display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; }
.privacy-copy { flex: 1; min-width: 0; }
.privacy-hint { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--ink-3); }
.privacy-row switch { flex: none; }
