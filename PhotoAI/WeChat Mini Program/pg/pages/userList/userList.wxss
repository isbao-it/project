.following-page {
  /* 自定义 tabBar 固定高 108rpx（custom-tab-bar/index.wxss），滚动视口避让它及安全区。 */
  height: calc(100vh - 108rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.following-header {
  flex: none;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}

.following-title {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.feed-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.feed-content {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.feed-card {
  width: 100%;
  margin-bottom: 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}

.feed-cover {
  position: relative;
}

.card-views {
  position: absolute;
  left: 16rpx;
  bottom: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
}

.feed-image {
  display: block;
  width: 100%;
  height: 500rpx;
  border-radius: 16rpx;
  background: var(--line);
}

.feed-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-3);
}

.feed-body {
  padding: 20rpx 24rpx;
}

.feed-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  line-height: 1.5;
  font-size: 30rpx;
  font-weight: 700;
}

.feed-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.author-avatar {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--pink-soft);
}

.author-placeholder {
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}

.author-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-tag {
  max-width: 40%;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--pink);
  background: var(--pink-soft);
}

.feed-likes {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--ink-3);
}

/* 空心心形由边框绘制，继承文字颜色，无外链图标或硬编码颜色。 */
.heart-icon {
  position: relative;
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.heart-icon::before,
.heart-icon::after {
  content: "";
  position: absolute;
  border: 2rpx solid currentColor;
}

.heart-icon::before {
  left: -2rpx;
  top: -10rpx;
  width: 16rpx;
  height: 10rpx;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.heart-icon::after {
  left: -10rpx;
  top: -2rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 0;
  border-radius: 16rpx 0 0 16rpx;
}

.feed-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.feed-action {
  min-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
  color: var(--card);
  background: var(--pink);
}

.feed-action:active,
.feed-card:active {
  opacity: .85;
}

.feed-end {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
